{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  // Format modele: "<provider>/<model-id>". Verifică ID-urile exacte cu `opencode models`.
  "model": "openai/gpt-6",
  "small_model": "ollama/qwen2.5-coder",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": { "baseURL": "http://localhost:11434/v1" },
      "models": { "qwen2.5-coder": { "name": "Qwen 2.5 local" } }
    }
  },
  "worktree": { "directory": "../opencode-worktrees" },
  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "deny" },
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "git status*", "effect": "allow" },
    { "action": "shell", "resource": "git diff*", "effect": "allow" },
    { "action": "shell", "resource": "git log*", "effect": "allow" },
    { "action": "shell", "resource": "git branch --show-current*", "effect": "allow" },
    { "action": "shell", "resource": "git push*", "effect": "deny" },
    { "action": "shell", "resource": "git reset*", "effect": "deny" },
    { "action": "shell", "resource": "git clean*", "effect": "deny" },
    { "action": "shell", "resource": "git merge*", "effect": "deny" },
    { "action": "shell", "resource": "git rebase*", "effect": "deny" },
    { "action": "shell", "resource": "git checkout*", "effect": "ask" },
    { "action": "shell", "resource": "git switch*", "effect": "ask" },
    { "action": "shell", "resource": "git commit*", "effect": "ask" },
    { "action": "shell", "resource": "git add*", "effect": "ask" }
  ],
  "agents": {
    "orchestrator": {
      "mode": "primary",
      "model": "openai/gpt-6",
      "description": "Planifică proiectul, deleagă analiza și verifică livrabilele; nu editează cod",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "architect", "effect": "allow" },
        { "action": "subagent", "resource": "reviewer", "effect": "allow" }
      ]
    },
    "developer": {
      "mode": "primary",
      "model": "openai/gpt-6",
      "description": "Implementează un task bine delimitat în worktree-ul propriu",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "allow" },
        { "action": "subagent", "resource": "*", "effect": "deny" }
      ]
    },
    "qa-local": {
      "mode": "primary",
      "model": "ollama/qwen2.5-coder",
      "description": "Generează teste mici și documentează rezultatele în worktree-ul de QA",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "allow" },
        { "action": "subagent", "resource": "*", "effect": "deny" }
      ]
    }
  }
}
